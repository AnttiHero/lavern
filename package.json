{
  "name": "lavern",
  "version": "0.14.3",
  "description": "Lavern — An agentic legal architecture. A law firm staffed with AI agents.",
  "license": "MIT",
  "author": "Antti Innanen",
  "homepage": "https://lavern.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnttiHero/Marble.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "shem": "dist/index.js",
    "lavern": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && cd viz && npx tsc --noEmit",
    "serve": "tsx src/index.ts --serve",
    "serve:dev": "tsx src/index.ts --serve --port 3000",
    "build:viz": "cd viz && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@anthropic-ai/sdk": "^0.78.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "@stripe/stripe-js": "^8.9.0",
    "better-sqlite3": "^12.6.2",
    "docx": "^9.6.0",
    "fastify": "^5.7.4",
    "mammoth": "^1.11.0",
    "marked": "^17.0.3",
    "openai": "^4.85.0",
    "pdf-parse": "^2.4.5",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^24.39.1",
    "resend": "^6.9.3",
    "stripe": "^20.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "author": "Legit (wearelegit.ai)",
  "license": "UNLICENSED",
  "private": true
}
