# ── Required ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Models ────────────────────────────────────────────────────────────────
SHEM_MODEL=claude-opus-4-6
SHEM_ROUTER_MODEL=claude-sonnet-4-5-20250929

# ── Budgets ───────────────────────────────────────────────────────────────
SHEM_DEFAULT_BUDGET=5.00
SHEM_MAX_TURNS=80
SHEM_GENERIC_MAX_TURNS=60

# ── Paths ─────────────────────────────────────────────────────────────────
SHEM_AUDIT_DIR=./audit-logs
SHEM_MEMORY_DIR=.shem/memory
SHEM_REPORTS_DIR=.shem/reports
SHEM_BASELINES_DIR=.shem/baselines
SHEM_DB_PATH=./data/marble.db

# ── API Server ────────────────────────────────────────────────────────────
SHEM_PORT=3000
SHEM_HOST=0.0.0.0
SHEM_CORS_ORIGINS=*
SHEM_BASE_URL=http://localhost:3000
# SHEM_TRUST_PROXY=true
# SHEM_MAX_UPLOAD_BYTES=10000000

# ── Rate Limiting ─────────────────────────────────────────────────────────
# SHEM_RATE_LIMIT_MAX=100
# SHEM_RATE_LIMIT_WINDOW_MS=60000
# SHEM_RATE_LIMIT_SESSION_MAX=10

# ── Sessions ──────────────────────────────────────────────────────────────
# SHEM_SESSION_TTL_MS=14400000
# SHEM_MAX_SESSIONS=100

# ── Payment (x402 — USDC on Base) ────────────────────────────────────────
# SHEM_X402_ENABLED=true
# SHEM_X402_RECIPIENT=0x...

# ── Logging ───────────────────────────────────────────────────────────────
SHEM_LOG_LEVEL=info

# ── Claw Mode (Law Firm on Retainer) ─────────────────────────────────────
# MARBLE_CLAW_DIR=~/.marble
# MARBLE_CLAW_BUDGET=50.0
# MARBLE_CLAW_PER_DOC_BUDGET=10.0
# MARBLE_CLAW_SCAN_INTERVAL=30000
# MARBLE_CLAW_MAX_FILE_SIZE=10485760
# MARBLE_CLAW_MAX_DOCS_PER_SCAN=50
# MARBLE_CLAW_WEBHOOK_URL=https://hooks.slack.com/...
# MARBLE_CLAW_MACOS_NOTIFY=true
# MARBLE_CLAW_NOTIFY_DEDUP_MS=300000

# ── Claw: Local Model (confidential docs) ────────────────────────────────
# MARBLE_LOCAL_MODEL_URL=http://localhost:11434
# MARBLE_LOCAL_MODEL=llama3.1:8b
# MARBLE_LOCAL_ANALYSIS_MODEL=llama3.1:70b

# ── Claw: Heartbeat ──────────────────────────────────────────────────────
# MARBLE_CLAW_HEARTBEAT=true
# MARBLE_CLAW_HEARTBEAT_INTERVAL=1800000
