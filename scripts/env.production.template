# Marble — Production Environment
#
# Copy this to .env and fill in your values:
#   cp scripts/env.production.template .env

# Required: Your Anthropic API key
# For better security, store in macOS Keychain instead:
#   ./scripts/keychain-setup.sh store
ANTHROPIC_API_KEY=sk-ant-...

# Claw Mode configuration
MARBLE_CLAW_DIR=/opt/marble/.marble
MARBLE_CLAW_BUDGET=100.0
MARBLE_CLAW_PER_DOC_BUDGET=10.0
MARBLE_CLAW_SCAN_INTERVAL=30000

# Claw Mode — Security (v0.8.1)
MARBLE_CLAW_MAX_FILE_SIZE=10485760
MARBLE_CLAW_MAX_DOCS_PER_SCAN=50

# Claw Mode — Notifications
# Set webhook URL for Slack/Discord/generic JSON notifications
MARBLE_CLAW_WEBHOOK_URL=
# macOS native notifications (disable with 'false')
MARBLE_CLAW_MACOS_NOTIFY=true

# Local Model — Confidential Document Analysis (Privilege Preservation)
# When set, documents matching sensitivity patterns are analyzed on-device.
# No content is transmitted to any external API.
# Requires Ollama: brew install ollama && ollama pull llama3.1:8b
MARBLE_LOCAL_MODEL_URL=http://localhost:11434
MARBLE_LOCAL_MODEL=llama3.1:8b
MARBLE_LOCAL_ANALYSIS_MODEL=llama3.1:70b

# API Server
SHEM_PORT=3000
SHEM_LOG_LEVEL=info
SHEM_CORS_ORIGINS=*

# TLS / Reverse Proxy
# When behind a reverse proxy (Caddy, nginx), enable trust proxy
# so Fastify reads X-Forwarded-For and X-Forwarded-Proto correctly.
# See scripts/Caddyfile.example for a ready-to-use TLS config.
SHEM_TRUST_PROXY=true

# Runtime
NODE_ENV=production
