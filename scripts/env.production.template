# Marble — Production Environment
#
# Copy this to .env and fill in your values:
#   cp scripts/env.production.template .env

# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Claw Mode configuration
MARBLE_CLAW_DIR=/opt/marble/.marble
MARBLE_CLAW_BUDGET=100.0
MARBLE_CLAW_PER_DOC_BUDGET=10.0
MARBLE_CLAW_SCAN_INTERVAL=30000

# API Server
SHEM_PORT=3000
SHEM_LOG_LEVEL=info
SHEM_CORS_ORIGINS=*

# Runtime
NODE_ENV=production
